# Copiar este archivo como ".env" y completar. El .env no se sube a git.

# Puerto donde corre la página
PORT=3000
# Dirección pública de la página: se usa en los enlaces de los mails. Ej: https://siniestros.genco.com.ar
# Si empieza con https:// se activan las cookies seguras (__Host-), HSTS y upgrade-insecure-requests.
APP_URL=http://localhost:3000
# Si la página está detrás de un proxy (nginx, Cloudflare, balanceador): "loopback" (nginx en la misma
# máquina), la cantidad de proxies (ej. 1) o sus IPs separadas por coma. Sirve para ver la IP real de
# cada visitante en los límites de intentos y en el registro de seguridad.
TRUST_PROXY=loopback

# Gmail desde el que salen los mails de "¿Olvidaste tu contraseña?".
# GMAIL_CLAVE_APP NO es la contraseña normal de la cuenta: es una "contraseña de aplicación" de 16 letras
# que se genera en https://myaccount.google.com/apppasswords (requiere la verificación en 2 pasos activada).
# Para probar: npm run probar-mail -- tu-email@ejemplo.com
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Cuenta de administración que se crea en el primer arranque (solo si todavía no existe ninguna).
# En el primer ingreso la página obliga a cambiar la contraseña.
ADMIN_EMAIL=admin@genco.local
ADMIN_PASSWORD=cambiar-esta-clave

# A dónde llegan las alertas de seguridad (cuentas bloqueadas por intentos, errores graves...).
# Vacío: a GMAIL_USUARIO. El detalle de todos los eventos queda en data/seguridad.log.
ALERTAS_EMAIL=

# Clave para firmar las sesiones (al menos 32 caracteres al azar). Vacía: se genera una y se guarda en
# data/session-secret. Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Cookies solo por conexión segura. Se activa sola si APP_URL empieza con https://
COOKIE_SECURE=0

# Cuenta de Genco en el sistema web de Sendbox (sendboxbfg.com.ar). La página entra sola cada
# SENDBOX_INTERVALO_MIN minutos y lee el estado de los envíos de Sendbox que no llegaron.
# Para probar: npm run probar-sendbox -- Z-0325-00000508
SENDBOX_USUARIO=
SENDBOX_CLAVE=
SENDBOX_INTERVALO_MIN=30
