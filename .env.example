PORT=3000
# Contraseña del usuario "admin" que se crea en el primer arranque (si no existe ningún administrador).
# Después se cambia desde el panel (menú de usuario > Cambiar contraseña).
ADMIN_PASSWORD=cambiar-esta-clave
# Clave para firmar las sesiones. Si se deja vacía se genera una y se guarda en data/session-secret.
SESSION_SECRET=
# Poner 1 cuando la página se sirva por HTTPS (cookies solo por conexión segura).
COOKIE_SECURE=0

# Dirección pública de la página (para los enlaces de "olvidé mi contraseña"). Ej: https://seguimiento.genco.com.ar
APP_URL=http://localhost:3000

# Cuenta de correo para enviar los mails de recuperación de contraseña.
# Sin SMTP_HOST, los mails se muestran en la consola del servidor.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=cuenta@gmail.com,
# SMTP_PASS=<contraseña de aplicación de Google>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Grupo Genco Siniestros <no-responder@genco.com.ar>"
