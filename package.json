{
  "name": "genco-siniestros-seguimiento",
  "version": "0.1.0",
  "private": true,
  "description": "Seguimiento de pedidos de siniestros de Grupo Genco: consulta por siniestro y patente, portal de talleres y peritos, y panel de administración.",
  "type": "module",
  "main": "backend/servidor.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/servidor.js",
    "dev": "node --watch --env-file-if-exists=.env backend/servidor.js",
    "probar-mail": "node --env-file-if-exists=.env backend/scripts/probar-mail.js",
    "probar-sendbox": "node --env-file-if-exists=.env backend/scripts/probar-sendbox.js",
    "vista-previa-aviso": "node --env-file-if-exists=.env backend/scripts/vista-previa-aviso.js",
    "auditar": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.0.16",
    "playwright": "^1.63.0"
  }
}
